{
  "name": "@local/fullwidth-conversation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Full-width transcript and composer for the Web conversation.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sagmans/dsh-fullwidth-conversation.git"
  },
  "homepage": "https://github.com/sagmans/dsh-fullwidth-conversation#readme",
  "bugs": {
    "url": "https://github.com/sagmans/dsh-fullwidth-conversation/issues"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/check.mjs smoke"
  }
}
